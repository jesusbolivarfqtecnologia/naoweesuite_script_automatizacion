{
  "endpoints": {
    "get_users": {
      "description": "Obtiene la lista de los usuarios",
      "uri": "https://back-pres-decreto.naoweesuite.com/beneficiaries?contractor_email=mejoramientohatonuevo@gmail.com",
      "method": "GET"
    },
    "get_beneficiary": {
      "description": "Obtiene el beneficiario con relaciones por user_id",
      "uri": "https://back-pres-decreto.naoweesuite.com/beneficiary-with-relationship/{{user_id}}",
      "method": "GET"
    },
    "get_chapters": {
      "description": "Obtiene la lista de los capitulos y actividades en el cesar que es el id 9",
      "uri": "https://back-pres-decreto.naoweesuite.com/region-category/9",
      "method": "GET"
    },
    "create_budget": {
      "description": "Crea un nuevo presupuesto",
      "uri": "https://back-pres-decreto.naoweesuite.com/create-budget/categories/subcategories/quantity",
      "method": "POST",
      "payload_template": "budget_payload"
    },
    "update_budget": {
      "description": "Actualiza un presupuesto",
